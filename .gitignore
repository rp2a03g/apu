# Local Claude Code settings (machine-specific paths, not for sharing)
.claude/settings.local.json

# Test fixtures copied from local ROM/sound rip collections (copyrighted, not for backup)
_tmp_test/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Node (in case tooling is added later)
node_modules/
npm-debug.log*

# Env files
.env
.env.*

# CPU命令テストのベクタキャッシュ(SingleStepTestsからDLしたJSON、1命令数MB)
tools/headless/.vectors/

# 一括変換の目視diff用ダンプ(regress.js --dump の出力)
tools/headless/dump*/

# 回帰テストのベースライン(手元のコーパス専用。曲名一覧を含み他人の環境では使えないため
# リポジトリには入れない。node tools/headless/check-all.js --update で作り直す)
tools/headless/baseline-*.json
# 手元の作業計画(実装ログ兼用。公開しない。公開向けの実装メモは IMPLEMENTATION.md)
ROADMAP.md
